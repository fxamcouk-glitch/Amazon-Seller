generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Channel {
  AMAZON
  SHOPIFY
  WEBSITE
}

enum OrderStatus {
  PAID
  SHIPPED
  CANCELLED
  REFUNDED
}

model Product {
  id        String    @id @default(cuid())
  sku       String    @unique
  name      String
  costPence Int       @default(0)
  listings  Listing[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// One product can have a listing per channel (Amazon ASIN, Shopify product, website page).
model Listing {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  channel         Channel
  externalId      String? // ASIN or Shopify product id
  title           String
  bullets         String[]
  description     String   @default("")
  backendKeywords String   @default("") // Amazon search terms; unused on other channels
  targetKeywords  String[] @default([])
  seoTitle        String? // Shopify/website SEO title
  metaDescription String?
  fnsku           String? // Amazon barcode id used on item labels
  updatedAt       DateTime @updatedAt

  @@unique([productId, channel])
}

model TrackedLink {
  id          String   @id @default(cuid())
  label       String
  destination String
  source      String
  medium      String
  campaign    String
  content     String?
  url         String // final URL with UTM / Attribution tags
  createdAt   DateTime @default(now())
}

model ChannelDailyStat {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  channel      Channel
  revenuePence Int
  orders       Int
  units        Int
  sessions     Int

  @@unique([date, channel])
}

// An order placed on our own website and paid through Stripe.
model Order {
  id              String      @id @default(cuid())
  number          Int         @unique @default(autoincrement()) // human-friendly order number
  stripeSessionId String      @unique
  status          OrderStatus @default(PAID)
  customerName    String
  customerEmail   String
  customerPhone   String?
  shipLine1       String
  shipLine2       String?
  shipCity        String
  shipRegion      String?
  shipPostcode    String
  shipCountry     String
  subtotalPence   Int
  shippingPence   Int         @default(0)
  totalPence      Int
  currency        String      @default("gbp")
  paidAt          DateTime
  createdAt       DateTime    @default(now())
  items           OrderItem[]
  invoice         Invoice?

  @@index([createdAt])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku            String
  name           String
  unitPricePence Int
  quantity       Int
}

// Invoice numbers come from InvoiceCounter inside the same transaction, so they are sequential
// with no gaps, even if an order fails halfway.
model Invoice {
  id       String   @id @default(cuid())
  orderId  String   @unique
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number   Int      @unique
  issuedAt DateTime @default(now())
  pdf      Bytes
}

model InvoiceCounter {
  id   Int @id
  last Int @default(0)
}

// Stripe retries webhooks; recording each event id once makes handling idempotent.
model StripeEvent {
  id         String   @id // Stripe's event id
  type       String
  receivedAt DateTime @default(now())
}
