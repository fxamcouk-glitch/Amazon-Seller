generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Channel {
  AMAZON
  SHOPIFY
  WEBSITE
}

enum OrderStatus {
  PAID
  SHIPPED
  CANCELLED
  REFUNDED
}

// One product per SKU. `name` is the internal name (also used for Amazon listings). The fields below
// it are only for the website: a product appears in the shop only when `published` is true.
model Product {
  id          String    @id @default(cuid())
  sku         String    @unique
  name        String
  costPence   Int       @default(0)
  displayName String    @default("") // customer-facing name for the shop; falls back to `name`
  slug        String?   @unique // web address of the product page
  pricePence  Int       @default(0)
  summary     String    @default("") // one sentence; also the meta description
  description String[]  @default([]) // paragraphs
  specs       Json      @default("[]") // [{ "label": "...", "value": "..." }]
  inStock     Boolean   @default(true)
  published   Boolean   @default(false)
  image       String? // /media/<id>.webp for an uploaded image, or an https address
  importedAt       DateTime? // when scripts/import-catalogue.ts last wrote this product from Amazon data
  importedImageUrl String? // the Amazon photo address that import last stored, to spot a changed photo
  imageAlt    String    @default("") // description of the image, for accessibility and search
  listings    Listing[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published])
}

// One product can have a listing per channel (Amazon ASIN, Shopify product, website page).
model Listing {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  channel         Channel
  externalId      String? // ASIN or Shopify product id
  title           String
  bullets         String[]
  description     String   @default("")
  backendKeywords String   @default("") // Amazon search terms; unused on other channels
  targetKeywords  String[] @default([])
  seoTitle        String? // Shopify/website SEO title
  metaDescription String?
  fnsku           String? // Amazon barcode id used on item labels
  updatedAt       DateTime @updatedAt

  @@unique([productId, channel])
}

model TrackedLink {
  id          String   @id @default(cuid())
  label       String
  destination String
  source      String
  medium      String
  campaign    String
  content     String?
  url         String // final URL with UTM / Attribution tags
  createdAt   DateTime @default(now())
}

model ChannelDailyStat {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  channel      Channel
  revenuePence Int
  orders       Int
  units        Int
  sessions     Int

  @@unique([date, channel])
}

// An order placed on our own website and paid through Stripe.
model Order {
  id                  String      @id @default(cuid())
  number              Int         @unique @default(autoincrement()) // human-friendly order number
  stripeSessionId     String      @unique
  status              OrderStatus @default(PAID)
  customerName        String
  customerEmail       String
  customerPhone       String?
  shipLine1           String
  shipLine2           String?
  shipCity            String
  shipRegion          String?
  shipPostcode        String
  shipCountry         String
  subtotalPence       Int
  shippingPence       Int         @default(0)
  totalPence          Int
  currency            String      @default("gbp")
  paidAt              DateTime
  createdAt           DateTime    @default(now())
  // Confirmation email: when it was accepted by the email service, its id there, and the last problem.
  confirmationSentAt  DateTime?
  confirmationEmailId String?
  confirmationError   String?
  items               OrderItem[]
  invoice             Invoice?

  @@index([createdAt])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku            String
  name           String
  unitPricePence Int
  quantity       Int
}

// Invoice numbers come from InvoiceCounter inside the same transaction, so they are sequential
// with no gaps, even if an order fails halfway.
model Invoice {
  id       String   @id @default(cuid())
  orderId  String   @unique
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number   Int      @unique
  issuedAt DateTime @default(now())
  pdf      Bytes
}

model InvoiceCounter {
  id   Int @id
  last Int @default(0)
}

// Stripe retries webhooks; recording each event id once makes handling idempotent.
model StripeEvent {
  id         String   @id // Stripe's event id
  type       String
  receivedAt DateTime @default(now())
}

// Uploaded product photos, stored in the database so the host needs no file storage. Each upload is
// re-encoded as a square WebP (a large and a thumbnail version); the original file is never kept.
model ProductImage {
  id        String   @id @default(cuid())
  large     Bytes
  thumb     Bytes
  side      Int // pixel size of the large version's square canvas
  createdAt DateTime @default(now())
}

// Login protection. AuthThrottle counts attempts per client in a fixed window; the count is raised in a
// single atomic statement so many simultaneous guesses cannot slip past the limit. AuthState holds the
// newest authenticator code step that was accepted, so a code cannot be used twice. AuthEvent is a
// short log of sign-ins for the owner to review.
model AuthThrottle {
  key         String   @id
  count       Int
  windowStart DateTime
}

model AuthState {
  key      String @id
  intValue Int    @default(0)
}

model AuthEvent {
  id   String   @id @default(cuid())
  at   DateTime @default(now())
  kind String // login_success, login_failure, login_blocked, logout, setup_view
  ip   String?

  @@index([at])
}
