# Copy to .env.local and fill in. .env.local is git-ignored — never commit real values.

# From Developer Central → "TheCable.Store Seller Hub Live" → LWA credentials → View
SP_API_CLIENT_ID=
SP_API_CLIENT_SECRET=
# From Developer Central → Live app → ▾ → Authorize app
SP_API_REFRESH_TOKEN=

# Not secret: your Merchant Token (Seller Central → Settings → Account Info → Merchant Token)
SP_API_SELLER_ID=

# Defaults for Amazon.co.uk (Europe region)
SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
SP_API_MARKETPLACE_ID=A1F83G8C2ARO7P
