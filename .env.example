# Postgres (e.g. Neon free tier)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Public site origin (no trailing slash); used for canonical links, sitemap and Stripe return URLs
SITE_URL="https://www.example.com"
# Password for the /admin dashboard (HTTP Basic auth; any username)
ADMIN_PASSWORD=""
# Stripe secret key for checkout
STRIPE_SECRET_KEY=""

# Claude API key for listing suggestions in the dashboard
ANTHROPIC_API_KEY=""
# Optional: override the model (default claude-opus-5-5); e.g. claude-haiku-5-5 is far cheaper
LISTING_MODEL=""
# Optional: where listings are stored until the database is connected (default data/listings.json)
LISTINGS_FILE=""
