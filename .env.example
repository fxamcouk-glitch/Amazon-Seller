# Postgres (e.g. Neon free tier)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Public site origin, REQUIRED for production builds and runs (builds fail without it);
# used for canonical links, sitemap, structured data and Stripe return URLs
SITE_URL="https://www.example.com"
# Password for the /admin dashboard (HTTP Basic auth; any username)
ADMIN_PASSWORD=""
# Stripe secret key for checkout
STRIPE_SECRET_KEY=""

# Claude API key for listing suggestions in the dashboard
ANTHROPIC_API_KEY=""
# Optional: override the model (default claude-opus-5-5); e.g. claude-haiku-5-5 is far cheaper
LISTING_MODEL=""
# Optional: where listings are stored until the database is connected (default data/listings.json)
LISTINGS_FILE=""

# Amazon Selling Partner API (set these as environment secrets; never commit them)
# Values come from Developer Central: "View sandbox credentials" (LWA client id and secret),
# and a refresh token from self-authorization of your own app.
SELLING_PARTNER_APP_CLIENT_ID=""
SELLING_PARTNER_APP_CLIENT_SECRET=""
SP_API_REFRESH_TOKEN=""
# eu covers the UK. Stays on the sandbox (example data) unless set to exactly "false".
SP_API_REGION="eu"
SP_API_SANDBOX="true"
